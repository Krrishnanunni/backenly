# ============================================================================
# The maintenance runner — the production runtime image plus one file.
# ============================================================================
#
# Phase 6b's entry point cannot ride the pattern the three lineage launchers
# use. Those carry their payload in a task-definition environment variable, and
# ECS caps a task definition at 64 KB; the maintenance bundle is ~285 KB
# brotli+base64 across 2216 modules, because it reaches the subsystem clustering
# and the whole structural-diagnosis engine. So the code travels in an image.
#
# The base is the PRODUCTION RUNTIME IMAGE, pinned by digest and passed in. That
# is deliberate: it already carries `@prisma/client` and the generated
# `.prisma` engine, which are the only things the bundle does not contain, and
# reusing it means this image cannot drift from what production actually runs.
#
# What is NOT here, on purpose: no Prisma CLI, no migration tooling, no replay
# or lineage tooling, no Layer 2/4 provisioning, no scheduler, no shell
# utilities. One file, one entrypoint. The narrower this stays, the less there
# is to reason about when it runs against a production database.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# The bundled entry point. `pg` is inside it; `@prisma/client` and `.prisma`
# resolve from the base image's /app/node_modules, which is why it lands in
# /app rather than anywhere else.
COPY maintenance.cjs /app/maintenance.cjs

# The acceptance fixture. One disposable project, one fixed shape, no arbitrary
# SQL — see scripts/maintenance-acceptance-fixture.ts. It ships here rather than
# in an image of its own because it needs the same Prisma client and the same
# guards, and because a second image is a second thing to keep pinned.
COPY fixture.cjs /app/fixture.cjs

# The pinned AWS RDS CA bundle.
#
# Prisma and node-postgres disagree about `sslmode=require`: Prisma follows
# libpq, where it means "encrypt, do not verify", while node-postgres verifies
# against the system trust store — which does not contain the RDS chain, so its
# pools fail with SELF_SIGNED_CERT_IN_CHAIN. Measured against production, not
# assumed.
#
# NODE_EXTRA_CA_CERTS adds this bundle to the trust store rather than disabling
# verification, so the connection is still authenticated. It is the same pinned
# bundle the lineage probes verify against.
COPY rds-ca.pem /app/rds-ca.pem
ENV NODE_EXTRA_CA_CERTS=/app/rds-ca.pem

WORKDIR /app
# The fixture is reached by overriding this at task launch, so the default
# remains the only thing that runs unless a caller asks for the other.
ENTRYPOINT ["node", "/app/maintenance.cjs"]
